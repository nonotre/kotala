# Copie para .env e preencha. O .env nunca vai para o git.

# Banco (docker compose lê estas mesmas variáveis)
POSTGRES_USER=kotala
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=kotala
POSTGRES_PORTA=5433
DATABASE_URL=postgres://kotala:troque-esta-senha@127.0.0.1:5433/kotala

# IA: rota principal (chave do hackathon) e rota de reserva (chave pessoal).
# Ambas são chaves do Gemini (AI Studio).
GEMINI_API_KEY=
GEMINI_API_KEY_RESERVA=

# Modelos por papel, em ordem de tentativa, separados por vírgula.
IA_MODELOS_RAPIDO=gemini-3.5-flash-lite,gemini-3.1-flash-lite
IA_MODELOS_FORTE=gemini-3.8-flash,gemini-3.6-flash
IA_TIMEOUT_MS=30000
# Banco só dos testes de integração (apagado a cada rodada)
DATABASE_URL_TESTE=postgres://kotala:troque-esta-senha@127.0.0.1:5433/kotala_teste

# Telegram: tokens do @BotFather. O do fornecedor é opcional por enquanto.
TELEGRAM_TOKEN_COMPRADOR=
TELEGRAM_TOKEN_FORNECEDOR=

# Negócio e demo
EMPRESA_NOME=Construtora Exemplo Ltda.
EMPRESA_CNPJ=00.000.000/0001-00
# Tempo para os fornecedores responderem (segundos), no modo demo. O lembrete sai na metade.
PRAZO_RESPOSTAS_SEG=300
# demo: usa PRAZO_RESPOSTAS_SEG. real: 3 dias (compra menor) ou 5 dias (acima de LIMITE_COMPRA_MAIOR reais).
PRAZO_MODO=demo
LIMITE_COMPRA_MAIOR=5000
# Minutos que o comprador tem para terminar o pedido (responder e confirmar); o lembrete sai ao fim.
JANELA_CONFIRMACAO_MIN=60
MAX_FORNECEDORES=8
# Multiplica o atraso dos fornecedores simulados (0.3 = mais rápido)
SIM_ATRASO_FATOR=1

# Busca real (R3)
# Serper (serper.dev): crédito único de 2.500 consultas. O app nunca passa de SERPER_LIMITE.
SERPER_API_KEY=
SERPER_LIMITE=300
# Horas que um resultado de busca fica guardado e é reaproveitado
BUSCA_CACHE_HORAS=24
# Teto de consultas pagas por item de pedido
BUSCA_MAX_CONSULTAS_ITEM=2
# snapshot: só usa buscas guardadas (demo sem rede); vivo: busca de verdade
BUSCA_MODO=vivo
# Endereço padrão de entrega da empresa fictícia (usado quando o pedido não diz o destino)
EMPRESA_CIDADE=São Paulo/SP
EMPRESA_ENDERECO=Obra Alfa, Rua de Exemplo, 100, Bela Vista, São Paulo/SP
EMPRESA_CEP=01310-100

# Pasta dos arquivos recebidos (PDF, foto, áudio), guardados com hash. Fica fora do git.
ARQUIVOS_DIR=dados/arquivos

# Portal da Transparência (chave gratuita por e-mail). Sem ela, as sanções vêm dos arquivos diários de dados abertos.
PORTAL_TRANSPARENCIA_CHAVE=

# Telas (Frente 1): API interna entre as telas e o processo dos bots.
# Gere um token aleatório (ex.: openssl rand -hex 24). Sem token, as telas ficam só de leitura.
API_INTERNA_TOKEN=
API_INTERNA_PORTA=3301
API_INTERNA_URL=http://127.0.0.1:3301

# E-mail (E1): convite do fornecedor com link pessoal do bot.
# Gmail com verificação em duas etapas e senha de app (myaccount.google.com/apppasswords);
# a senha de app tem 16 letras, sem espaços.
SMTP_USER=meuprojeto.avisos@gmail.com
SMTP_PASS=abcdefghijklmnop
# Nome que aparece como remetente (padrão: "Cotações <EMPRESA_NOME>")
EMAIL_REMETENTE_NOME=
# Trava: envio automático (cotação, lembrete) só para estes endereços, separados por vírgula.
# Quem recebe convite manual (npm run convidar) também fica liberado. Nenhum outro recebe e-mail.
EMAIL_PERMITIDOS=

# Voz em tempo real (X5): modelo do Gemini Live
VOZ_MODELO=gemini-3.8-live

# Assistente do chat web (Frente 3, docs/frente-3-harness.md).
# ASSISTENTE=desligado volta o chat web ao fluxo puro (toda mensagem vira pedido ou correção).
ASSISTENTE=
# Cadeias de modelos: a conversa começa no primeiro; pergunta que pede explicação ou resposta
# reprovada na conferência vai ao forte; "juiz" só na avaliação (npm run assistente:avaliar).
IA_MODELOS_CONVERSA=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.1-flash-lite
IA_MODELOS_CONVERSA_FORTE=gemini-3.8-flash,gemini-3.5-flash
IA_MODELOS_JUIZ=gemini-4-argon,gemini-3.8-flash

# Guardrails (Frente 4, S): aviso ao gestor de compras. Ainda não existe papel de gestor;
# até lá, o aviso vai ao contato com este id (tabela contato). Sem ele, o caso só fica no rastro.
GESTOR_CONTATO_ID=
# 1 desliga o aviso ao gestor (demo, quando o time testa injeção o tempo todo). O rastro continua.
GUARDRAIL_MODO_DEMO=
# Nicho da empresa (Frente 4, G): só escolhe exemplos e o jargão padrão; nunca limita o que
# pode ser pedido. Ids de src/dominio/categorias.json, separados por vírgula. Padrão: geral.
EMPRESA_NICHO=

# Regras de 08/11 (branch sim-fornecedor, docs/telegram-simulado.md).
# R11: o que o agente passa ao fornecedor que pede dados da empresa, além de razão social, CNPJ e endereço.
EMPRESA_JANELA_RECEBIMENTO=
EMPRESA_RECEBEDOR=
# R14b: quantas vezes o comprador pode estender o prazo de um item na mesma rodada. Padrão: 2.
MAX_PRORROGACOES=
